# Copied to .env.local by `just setup`. Fill in that copy: it's gitignored,
# this file is not. Everything here is yours; .env holds what everyone shares.
#
# `just dev` and `just run` read this. Only the CODECITY_* vars are passed into
# the container, so the Forgejo token below never reaches the api. A `-e` flag
# beats the value here for a single run.

# ── Local run ────────────────────────────────────────────────────
# Directories to mount read-only, so codecity can render the repos inside
# them. Comma-separated. Setting this turns CODECITY_ALLOW_LOCAL_REPOS on.
CODECITY_MOUNT=

# Marks a public deployment, where a local path can never resolve. Changes the
# advice shown when a repo can't be reached. Set it to see what codecity.io
# shows.
CODECITY_HOSTED=

# The landing's Discover tab. `off` hides it; point DISCOVER_FILE at your own
# JSON array of {"url", "label"} to curate the list.
CODECITY_DISCOVER=
CODECITY_DISCOVER_FILE=

# Silence disconnect and scan logs.
CODECITY_QUIET=

# ── Deploy ───────────────────────────────────────────────────────
# Read by `just deploy`. Never passed into the container.

# Instance root, no trailing slash.
FORGEJO_HOST=

# owner/repo holding .forgejo/workflows/deploy.yml
FORGEJO_REPO=

# Forgejo → Settings → Applications. Scope: repository → Read and Write.
FORGEJO_TOKEN=
