{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "jsx": "preserve",
    "jsxImportSource": "preact",

    // Flipped one at a time, each in its own reviewable change. strictNullChecks
    // came on with the nullable FileNode.size (#186): with it off, making a hot
    // wire field nullable produced zero errors, so the compiler was blind to the
    // exact bug being fixed. noImplicitAny is still pending.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Path alias mirrored in vite.config.js + vitest.config.js. `@/`
    // maps to app/src so cross-directory imports stay short and survive
    // file moves. Editor + tsc resolve through `paths`; bundler +
    // tests resolve through `resolve.alias`.
    "paths": {
      "@/*": ["./src/*"]
    },

    // Explicit allowlist prevents auto-inclusion of every package under
    // node_modules/@types/ (the TS default). Without this, @types/node
    // bleeds into browser source after it was installed for tests/visual.
    // "three" is required because three.js ships no bundled .d.ts files;
    // "webxr" is @types/three's declared dependency and referenced in its
    // declarations (XRSession etc.), so it must be listed here too.
    "types": ["three", "webxr"]
  },
  "include": ["**/*.js", "**/*.ts", "**/*.tsx", "tests/**/*"],
  "exclude": [
    "node_modules",
    // Node-side scripts — checked by tsconfig.node.json which adds @types/node.
    // Excluding them here prevents @types/node from bleeding into browser source
    // via `import 'node:path'` etc. in these files.
    "vite.config.js",
    "vitest.config.js",
    "tests/visual/**/*",
    // Use Node built-ins (fs/path/url) to read GLSL source files at test
    // time — checked by tsconfig.node.json which adds @types/node.
    "tests/city/utils/shaders/hslShader.test.ts",
    "tests/city/utils/shaders/hashShader.test.ts",
    "tests/city/components/buildings/building-shader.test.ts",
    "tests/city/components/sky/skyShader.test.ts",
    "tests/styles/themePresets.test.ts",
    "tests/styles/tokens.test.ts"
  ]
}
