{
  "name": "codecity",
  "version": "1.0.0",
  "description": "Visualize any codebase as an isometric 3D city. Frontend (Vite) for the codecity Python package.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "coverage": "vitest run --project=unit --coverage",
    "bench": "vitest run --project=bench",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --rule '{\"house/comment-length\":\"off\",\"house/css-comment-length\":\"off\"}'",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalida/codecity.git"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thalida/codecity/issues"
  },
  "homepage": "https://github.com/thalida/codecity#readme",
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "canvas": "^3.2.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "material-icon-theme": "^5.39.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lucide-preact": "^1.44.0",
    "marked": "^18.0.12",
    "preact": "^10.29.8",
    "rbush": "^4.0.1",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "wouter-preact": "^3.11.0"
  }
}
