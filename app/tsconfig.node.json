{
  // Covers Node-side scripts: vite.config.js, vitest.config.js, and the
  // visual-regression test harness (tests/visual/**). Extends the root
  // tsconfig but overrides "types" so that Node built-ins (fs, path, url,
  // child_process, Buffer) are available here without bleeding into browser
  // source. DOM lib is kept because page.evaluate() callbacks are typed with
  // browser globals (window, document) even though the outer script runs in
  // Node. The root tsconfig explicitly excludes these files so only this
  // config checks them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "vite.config.js",
    "vitest.config.js",
    "tests/visual/**/*",
    "tests/scene/utils/color/hsl-glsl-parity.test.ts",
    "tests/scene/components/buildings/building-shader.test.ts",
    "tests/scene/sky/skyShader.test.ts",
    "tests/constants/icons.test.ts"
  ],
  "exclude": ["node_modules"]
}
