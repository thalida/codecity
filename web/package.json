{
  "name": "codecity",
  "version": "1.0.0",
  "description": "Visualize any codebase as an isometric 3D city. Frontend (Vite) for the codecity Python package.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalida/codecity.git"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thalida/codecity/issues"
  },
  "homepage": "https://github.com/thalida/codecity#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "nanostores": "^1.3.0"
  }
}
