{
  // Covers the Node-side visual-regression test harness (tests/visual/**).
  // Extends the root tsconfig but overrides types/exclude so that Node
  // built-ins (fs, path, url, child_process, Buffer) are available here
  // without bleeding into browser source. DOM lib is kept because
  // page.evaluate() callbacks are typed with browser globals (window,
  // document) even though the outer script runs in Node.
  // The root tsconfig explicitly excludes tests/visual so only this
  // config checks those files.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["tests/visual/**/*"],
  "exclude": ["node_modules", "../codecity/static"]
}
