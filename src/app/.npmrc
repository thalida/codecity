# openapi-typescript (dev-only TS codegen for src/types/manifest.generated.ts)
# still declares peer typescript@^5.x, but the project runs typescript@^6.
# The tool only consumes the TS compiler API to emit plain .ts text and works
# fine on TS 6, so we accept the peer mismatch. Required so `npm ci` (CI,
# Docker, dev/test compose) reproduces the same resolution as `npm install`.
legacy-peer-deps=true
