{
  "name": "codecity",
  "version": "1.0.0",
  "description": "Visualize any codebase as an isometric 3D city. Frontend (Vite) for the codecity Python package.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "coverage": "vitest run --project=unit --coverage",
    "bench": "vitest run --project=bench",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --rule '{\"house/comment-length\":\"off\",\"house/css-comment-length\":\"off\"}'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalida/codecity.git"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thalida/codecity/issues"
  },
  "homepage": "https://github.com/thalida/codecity#readme",
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.12.1",
    "canvas": "^3.2.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.49.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@codecity/city": "file:../city",
    "@preact/signals": "^2.9.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.11.1",
    "lucide-preact": "^1.17.0",
    "marked": "^18.0.3",
    "preact": "^10.29.2",
    "rbush": "^4.0.1",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.11",
    "wouter-preact": "^3.10.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "endOfLine": "lf",
    "arrowParens": "always"
  }
}
