{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // strictNullChecks only, matching packages/app — the other two are pending there
    // (#186) and the packages are not going to be stricter than the code moving
    // into them.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,

    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Explicit allowlist prevents auto-inclusion of every package under
    // node_modules/@types/ (the TS default).
    "types": [],

    // Temporary, and the load-bearing piece of the extraction (#208): code
    // moved in here keeps resolving its `@/` imports against the app while
    // those imports are removed one family at a time. Deleted once
    // `grep "@/" packages/city/src` comes back empty.
    "paths": {
      "@/city/*": ["./src/*"],
      // A peer dependency, so it is not installed here. One copy or the app's
      // effect never sees this package's write. Goes with signals (step 11).
      "@preact/signals": ["../app/node_modules/@preact/signals"],
      "@/*": ["../app/src/*"]
    },

    // three ships no bundled .d.ts; webxr is @types/three's own dependency.
    "types": ["three", "webxr"],
    "jsx": "preserve",
    "jsxImportSource": "preact"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "vite.config.js"]
}
