{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // strictNullChecks only, matching packages/app — the other two are pending there
    // (#186) and the packages are not going to be stricter than the code moving
    // into them.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,

    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Explicit allowlist prevents auto-inclusion of every package under
    // node_modules/@types/ (the TS default).
    "types": [],

    // `@/city/*` is this package's own root, kept so the ~700 import sites
    // that already spell it that way stay valid. It resolves HERE: nothing in
    // src/ reaches outside this directory any more (#208 step 10).
    "paths": {
      "@/city/*": ["./src/*"]
    },

    // three ships no bundled .d.ts; webxr is @types/three's own dependency.
    "types": ["three", "webxr"],
    "jsx": "preserve",
    "jsxImportSource": "preact"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "vite.config.js"]
}
