{
  "name": "@codecity/city",
  "version": "0.0.0",
  "description": "Render any codebase as a 3D city. Give it a canvas, an API base and a repo; it fetches, builds, and tells you what it is doing.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalida/codecity.git",
    "directory": "packages/city"
  },
  "bugs": {
    "url": "https://github.com/thalida/codecity/issues"
  },
  "homepage": "https://github.com/thalida/codecity#readme",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codecity/client": "file:../client"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "endOfLine": "lf",
    "arrowParens": "always"
  }
}
