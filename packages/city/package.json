{
  "name": "@codecity/city",
  "version": "0.0.0",
  "description": "Render any codebase as a 3D city. Give it a canvas, an API base and a repo; it fetches, builds, and tells you what it is doing.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./preact": "./src/preact/index.ts",
    "./testing": "./tests/index.ts",
    "./testing/three": "./tests/_helpers/threeMock.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalida/codecity.git",
    "directory": "packages/city"
  },
  "bugs": {
    "url": "https://github.com/thalida/codecity/issues"
  },
  "homepage": "https://github.com/thalida/codecity#readme",
  "scripts": {
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "coverage": "vitest run --project=unit --coverage",
    "bench": "vitest run --project=bench",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.7",
    "canvas": "^3.2.3",
    "jsdom": "^29.0.2",
    "material-icon-theme": "^5.30.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "preact": "^10.29.2"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "endOfLine": "lf",
    "arrowParens": "always"
  },
  "dependencies": {
    "rbush": "^4.0.1",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.11"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  }
}
