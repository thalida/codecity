#!/usr/bin/env bash
# Pre-push gate: run the same checks CI runs before allowing a push to origin.
# Bypass with: git push --no-verify
#
# What runs (in this order — fail fast):
#   1. Python tests (api/) — pytest
#   2. Python lint + format — ruff check, ruff format --check, comment cap
#   3. Python types (api/) — pyright, strict
#   4. Frontend tests (app/) — vitest
#   5. Frontend lint + typecheck (app/)
#   6. Formatting — prettier --check (whole repo, from the root)
#   7. Generated TS types still match the Pydantic models
#
# Most of it runs in containers, so the gate doesn't depend on whatever the host
# happens to have installed. The exceptions are the two stdlib/uv checks that no
# single image can host: the Python comment cap, and step 7.

set -e

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

echo "[pre-push] running quality gate..."

echo "[pre-push] 1/7  pytest (api/)"
docker compose -f docker-compose.test.yml run --rm pytest >/dev/null

echo "[pre-push] 2/7  ruff check + format --check (api/)"
docker compose -f docker-compose.test.yml run --rm ruff >/dev/null
# On the host: it is stdlib-only, and running it here costs nothing.
uv run python bin/check-comments.py api bin scripts

echo "[pre-push] 3/7  pyright (api/)"
docker compose -f docker-compose.test.yml run --rm pyright >/dev/null

echo "[pre-push] 4/7  vitest (app/)"
docker compose -f docker-compose.test.yml run --rm vitest >/dev/null

# app/'s comment cap runs over what this push changes, not the whole tree: that
# rule arrived long after its comments did. api/ has no such backlog, so its cap
# above runs over everything. Listed here (git is on the host), linted in there.
CHANGED_APP=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- 'app/**' \
    | grep -E '\.(js|mjs|cjs|ts|tsx|css)$' | sed 's|^app/||' | tr '\n' ' ' || true)

# One container for all of it: each is seconds of work behind a slow start.
# Same command `just lint` runs, so the gate and the recipe can't diverge.
echo "[pre-push] 5/7  eslint + typecheck (app/)"
NPM_VERSION=$(grep '^NPM_VERSION=' .env | cut -d= -f2)
docker compose -f docker-compose.test.yml run --rm vitest \
    sh -c "npm install -g npm@$NPM_VERSION && npm ci && npm run lint && npm run typecheck \
        && { [ -z '$CHANGED_APP' ] || npx eslint $CHANGED_APP; }" >/dev/null

# Its own container: the app-scoped vitest service can't see the root config.
echo "[pre-push] 6/7  prettier --check (repo root)"
docker compose -f docker-compose.test.yml run --rm prettier >/dev/null

# On the host, not in a container: it needs uv and npx in the same place.
echo "[pre-push] 7/7  generated types match the models"
uv run python bin/check-generated-types.py

echo "[pre-push] all checks passed — pushing"
