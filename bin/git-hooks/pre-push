#!/usr/bin/env bash
# Pre-push gate: run the same checks CI runs before allowing a push to origin.
# Bypass with: git push --no-verify
#
# What runs (in this order — fail fast):
#   1. Python tests (packages/api/) — pytest
#   2. Python lint + format — ruff check, ruff format --check, comment cap
#   3. Python types (packages/api/) — pyright, strict
#   4. Frontend tests (packages/app/) — vitest
#   5. Frontend lint + typecheck (packages/app/)
#   6. city/ — typecheck + prettier --check
#   7. Generated TS types still match the Pydantic models
#
# Most of it runs in containers, so the gate doesn't depend on whatever the host
# happens to have installed. The exception is the Python comment cap, which is
# stdlib-only, and the uv half of step 7 that produces the schema to diff.

set -e

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

echo "[pre-push] running quality gate..."

echo "[pre-push] 1/7  pytest (packages/api/)"
docker compose -f docker-compose.test.yml run --rm pytest >/dev/null

echo "[pre-push] 2/7  ruff check + format --check (packages/api/)"
docker compose -f docker-compose.test.yml run --rm ruff >/dev/null
# On the host: it is stdlib-only, and running it here costs nothing.
uv run --project packages/api python bin/check-comments.py packages/api/api packages/api/scripts bin

echo "[pre-push] 3/7  pyright (packages/api/)"
docker compose -f docker-compose.test.yml run --rm pyright >/dev/null

echo "[pre-push] 4/7  vitest (packages/app/)"
docker compose -f docker-compose.test.yml run --rm vitest >/dev/null

# The app's comment cap runs over what this push changes, not the whole tree:
# that rule arrived long after its comments did. packages/api/ has no such backlog,
# so its cap above runs over everything. Listed here (git is on the host),
# linted in there — paths are app-relative because that is the container's cwd.
CHANGED_APP=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- 'packages/app/**' \
    | grep -E '\.(js|mjs|cjs|ts|tsx|css)$' | sed 's|^packages/app/||' | tr '\n' ' ' || true)

# One container for all of it: each is seconds of work behind a slow start.
# Same command `just lint` runs, so the gate and the recipe can't diverge.
echo "[pre-push] 5/7  eslint + typecheck (packages/app/)"
NPM_VERSION=$(grep '^NPM_VERSION=' .env | cut -d= -f2)
docker compose -f docker-compose.test.yml run --rm vitest \
    sh -c "npm install -g npm@$NPM_VERSION && (cd /city && npm ci) && npm ci && npm run lint && npm run typecheck \
        && npm run format:check \
        && { [ -z '$CHANGED_APP' ] || npx eslint $CHANGED_APP; }" >/dev/null

# Prettier lives inside each package now, so there is no repo-wide format check:
# README, AGENTS.md, the compose files and the workflows belong to no package and
# are deliberately hand-formatted.
echo "[pre-push] 6/7  typecheck + prettier --check (city/)"
docker compose -f docker-compose.test.yml run --rm packages >/dev/null

# uv writes the schema on the host, the container regenerates and diffs it.
echo "[pre-push] 7/7  generated types match the models"
just check-types-fresh >/dev/null

echo "[pre-push] all checks passed — pushing"
