#!/usr/bin/env bash
# Pre-push gate: run the same checks CI runs before allowing a push to origin.
# Bypass with: git push --no-verify
#
# What runs (in this order — fail fast):
#   1. Python tests (api/) — pytest
#   2. Python format — ruff format --check
#   3. Frontend tests (app/) — vitest
#   4. Frontend lint + prettier + typecheck (app/)
#
# Every step runs in a container, so the gate doesn't depend on whatever the
# host happens to have installed — a fresh worktree could not push before this.

set -e

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

echo "[pre-push] running quality gate..."

echo "[pre-push] 1/4  pytest (api/)"
docker compose -f docker-compose.test.yml run --rm pytest >/dev/null

echo "[pre-push] 2/4  ruff format --check (api/)"
docker compose -f docker-compose.test.yml run --rm ruff >/dev/null

echo "[pre-push] 3/4  vitest (app/)"
docker compose -f docker-compose.test.yml run --rm vitest >/dev/null

# One container for all three: each is seconds of work behind a slow start.
# Same command `just lint` runs, so the gate and the recipe can't diverge.
echo "[pre-push] 4/4  eslint + prettier + typecheck (app/)"
NPM_VERSION=$(grep '^NPM_VERSION=' .env | cut -d= -f2)
docker compose -f docker-compose.test.yml run --rm vitest \
    sh -c "npm install -g npm@$NPM_VERSION && npm ci && npm run lint && npm run typecheck && npm run format:check" >/dev/null

echo "[pre-push] all checks passed — pushing"
