# Tracked: contains version pins, no secrets.
#
# Pinned versions used by docker-compose, justfile, and CI workflows.
# Keep in sync with the Dockerfile's ARG NPM_VERSION default and the
# NPM_VERSION env in .github/workflows/ci.yml.
NPM_VERSION=11.6.2

# Forgejo deploy target for `just deploy`, which dispatches the deploy.yml
# workflow that owns this app's compose stack. Not secrets: the token lives in
# .local/deploy.env (gitignored), never here.
#   FORGEJO_HOST — instance root, no trailing slash, e.g. https://git.example.com
#   FORGEJO_REPO — owner/repo holding .forgejo/workflows/deploy.yml
FORGEJO_HOST=
FORGEJO_REPO=
FORGEJO_DEPLOY_APP=app-codecity
