# Tracked: contains version pins, no secrets.
#
# Pinned versions used by docker-compose, justfile, and CI workflows.
# Keep in sync with the Dockerfile's ARG NPM_VERSION default and the
# NPM_VERSION env in .github/workflows/ci.yml.
NPM_VERSION=11.6.2

# Which app `just deploy` dispatches. Safe to track: it's this project's own
# name. The Forgejo instance it deploys TO — host, repo and token — lives in
# .local/deploy.env, which is gitignored: this repo is public, and the host and
# repo alone would publish the layout of a private homelab.
FORGEJO_DEPLOY_APP=app-codecity
