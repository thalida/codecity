# Forgejo deploy target for `just deploy`. `just setup` copies this to
# .local/deploy.env, which is gitignored; fill that copy in, not this one.
#
# Host and repo live there rather than in the tracked .env because this repo is
# public, and the two together would publish the layout of a private homelab.

# Forgejo instance root, no trailing slash.
FORGEJO_HOST=

# owner/repo holding .forgejo/workflows/deploy.yml
FORGEJO_REPO=

# Forgejo → Settings → Applications → Generate token.
# Scopes: repository → Read and Write. Everything else No access.
FORGEJO_TOKEN=
