# Template for .local/deploy.env, which `just deploy` reads:
#
#   cp deploy.env.example .local/deploy.env
#
# .local/ is gitignored. Host and repo live there rather than in the tracked
# .env because this repo is public, and the two together would publish the
# layout of a private homelab.

# Forgejo instance root, no trailing slash.
FORGEJO_HOST=https://git.example.com

# owner/repo holding .forgejo/workflows/deploy.yml
FORGEJO_REPO=owner/repo

# Forgejo → Settings → Applications → Generate token.
# Scopes: repository → Read and Write. Everything else No access.
FORGEJO_TOKEN=
