{
  // Shared by every TypeScript workspace (app/, city/, client/). Each one
  // extends this and adds only what is genuinely its own: its `paths`, its
  // `types` allowlist, its JSX settings, its include/exclude.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Flipped one at a time, each in its own reviewable change. strictNullChecks
    // came on with the nullable FileNode.size (#186): with it off, making a hot
    // wire field nullable produced zero errors, so the compiler was blind to the
    // exact bug being fixed. noImplicitAny is still pending.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Explicit allowlist prevents auto-inclusion of every package under
    // node_modules/@types/ (the TS default). Without this, @types/node
    // bleeds into browser source after it was installed for tests/visual.
    // Empty here so a workspace opts in to exactly what it needs.
    "types": []
  }
}
